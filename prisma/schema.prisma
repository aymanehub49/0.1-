generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum ServiceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ReportType {
  SERVICE
  PROVIDER
  CLIENT
  MESSAGE
  REVIEW
}

enum ReportReason {
  SCAM
  FRAUD
  OFFENSIVE_CONTENT
  FAKE_SERVICE
  COPYRIGHT_VIOLATION
  HARASSMENT
  OTHER
}

enum NotificationType {
  NEW_MESSAGE
  NEW_ORDER
  ORDER_ACCEPTED
  ORDER_REJECTED
  DELIVERY
  REVISION_REQUEST
  ORDER_COMPLETED
  NEW_REVIEW
  PAYMENT
  WITHDRAWAL
  ADMIN_MESSAGE
}

enum ServiceType {
  ONLINE
  IN_PERSON
  BOTH
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?
  name          String?
  image         String?
  role          UserRole  @default(CLIENT)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  providerProfile ProviderProfile?
  services      Service[]
  ordersAsClient Order[] @relation("ClientOrders")
  ordersAsProvider Order[] @relation("ProviderOrders")
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  conversations1    Conversation[] @relation("User1")
  conversations2    Conversation[] @relation("User2")
  reviewsGiven      Review[] @relation("Reviewer")
  reviewsReceived   Review[] @relation("Reviewee")
  favorites         Favorite[]
  notifications     Notification[]
  payments          Payment[]
  wallet            Wallet?
  withdrawals       Withdrawal[]
  reports           Report[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  phone       String?
  city        String?
  bio         String?  @db.Text
  languages   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  username          String            @unique
  skills            String[]
  responseTime      Int?              // in hours
  totalJobs         Int               @default(0)
  completedJobs     Int               @default(0)
  isVerified        Boolean           @default(false)
  verificationDate   DateTime?
  profileViews      Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioItems    PortfolioItem[]
  verificationRequest VerificationRequest?

  @@index([username])
  @@index([isVerified])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  nameFr      String?
  slug        String   @unique
  icon        String?
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subcategories Subcategory[]
  services      Service[]

  @@index([slug])
  @@index([order])
}

model Subcategory {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  nameAr      String?
  nameFr      String?
  slug        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([categoryId])
  @@index([slug])
}

model Service {
  id          String        @id @default(cuid())
  userId      String
  categoryId  String
  subcategoryId String?
  title       String
  slug        String        @unique
  description String        @db.Text
  status      ServiceStatus @default(DRAFT)
  serviceType ServiceType   @default(ONLINE)
  city        String?
  location    String?
  viewCount   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category          @relation(fields: [categoryId], references: [id])
  subcategory  Subcategory?      @relation(fields: [subcategoryId], references: [id])
  images       ServiceImage[]
  packages     ServicePackage[]
  requirements ServiceRequirement[]
  reviews      Review[]
  favorites    Favorite[]
  orders       Order[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
}

model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServicePackage {
  id          String   @id @default(cuid())
  serviceId   String
  name        String
  description String   @db.Text
  price       Int      // in MAD
  deliveryDays Int
  revisions   Int
  features    String[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([serviceId])
}

model ServiceRequirement {
  id        String   @id @default(cuid())
  serviceId String
  question  String
  type      String   // text, file, multiple_choice
  options   String[] // for multiple_choice
  required  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  providerId  String
  title       String
  description String?  @db.Text
  images      String[]
  projectUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerProfile ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  serviceId String?
  providerId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@unique([userId, providerId])
  @@index([userId])
  @@index([serviceId])
}

model Order {
  id              String       @id @default(cuid())
  clientId        String
  providerId      String
  serviceId       String
  packageId       String
  status          OrderStatus  @default(PENDING)
  requirements    String?      @db.Text
  clientNotes     String?      @db.Text
  providerNotes   String?      @db.Text
  deadline        DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  amount          Int          // in MAD
  platformFee     Int          // in MAD
  providerEarnings Int         // in MAD
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  client   User     @relation("ClientOrders", fields: [clientId], references: [id])
  provider User     @relation("ProviderOrders", fields: [providerId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
  package  ServicePackage @relation(fields: [packageId], references: [id])
  messages Message[]
  reviews  Review[]
  payments Payment[]

  @@index([clientId])
  @@index([providerId])
  @@index([serviceId])
  @@index([status])
}

model Conversation {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  orderId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1 User @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1Id, user2Id, orderId])
  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  receiverId     String
  orderId        String?
  content        String   @db.Text
  attachments    String[]
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User @relation("SentMessages", fields: [senderId], references: [id])
  receiver     User @relation("ReceivedMessages", fields: [receiverId], references: [id])
  order        Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([orderId])
}

model Review {
  id          String   @id @default(cuid())
  orderId     String   @unique
  reviewerId  String
  revieweeId  String
  serviceId   String
  rating      Int      // 1-5
  communication Int
  quality     Int
  delivery    Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order    Order @relation(fields: [orderId], references: [id])
  reviewer User  @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee User  @relation("Reviewee", fields: [revieweeId], references: [id])
  service  Service @relation(fields: [serviceId], references: [id])

  @@index([reviewerId])
  @@index([revieweeId])
  @@index([orderId])
  @@index([serviceId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  userId      String
  amount      Int           // in MAD
  status      PaymentStatus @default(PENDING)
  paymentMethod String?
  transactionId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  availableBalance Int     @default(0) // in MAD
  pendingBalance  Int      @default(0) // in MAD
  totalEarnings   Int      @default(0) // in MAD
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  withdrawals  Withdrawal[]

  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String   // EARNING, WITHDRAWAL, REFUND, FEE
  amount      Int      // in MAD
  description String   @db.Text
  orderId     String?
  withdrawalId String?
  createdAt   DateTime @default(now())

  wallet      Wallet      @relation(fields: [walletId], references: [id])
  withdrawal  Withdrawal? @relation(fields: [withdrawalId], references: [id])

  @@index([walletId])
  @@index([orderId])
}

model Withdrawal {
  id          String           @id @default(cuid())
  walletId    String
  userId      String
  amount      Int              // in MAD
  status      WithdrawalStatus @default(PENDING)
  bankName    String?
  accountNumber String?
  rejectionReason String?     @db.Text
  processedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  wallet       Wallet        @relation(fields: [walletId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([walletId])
  @@index([userId])
  @@index([status])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reportedId  String
  type        ReportType
  reason      ReportReason
  description String       @db.Text
  status      ReportStatus @default(PENDING)
  adminNotes  String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter User @relation(fields: [reporterId], references: [id])

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
}

model VerificationRequest {
  id          String            @id @default(cuid())
  providerId  String            @unique
  fullName    String
  phone       String
  city        String
  idDocument  String?
  businessDocument String?
  status      VerificationStatus @default(PENDING)
  rejectionReason String?       @db.Text
  submittedAt DateTime          @default(now())
  reviewedAt  DateTime?

  providerProfile ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
}

model AdminAction {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  targetId    String
  targetType  String
  description String   @db.Text
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([targetType])
}

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}
